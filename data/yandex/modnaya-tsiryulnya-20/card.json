  "videos": [],
  "reviews_preview": [
    {
      "review_id": "U1_48--zuEk2Nhbm2064fEqb9cCgdWix",
      "author": "наташа п.",
      "text": "Являюсь постоянным клиентом салона и всегда остаюсь в полном восторге! В салоне ощущается атмосфера уюта и комфорта. Персонал  приветлив.\nОсобенно хочу отметить работу мастера Мишакову Ольгу , которая делала мне стрижку и окрашивание. Профессиональный подход, внимание к деталям и умение найти общий язык с клиентом — это именно то, что я ценю в специалистах. Результат превзошел все мои ожидания: прическа выглядит стильно и естественно, цвет идеально подобран.\nВ салоне приятно удивила чистота и современный интерьер. Все процедуры проводились с использованием качественных материалов и инструментов. Администратор грамотно проконсультировала по уходу за волосами после окрашивания, дала полезные рекомендации.",
      "rating": 5,
      "date": "2025-11-13",
      "photos": [],
      "business_reply": null
    },
    {
      "review_id": "K2lBw_4AmGXD9__A5LHHmn-ta8vV3BG",
      "author": "Лиса",
      "text": "Около 18 лет я хожу в этот салон.Корсикова Светлана мой мастер и моя любовь.Сколько мы с ней прошли :черный,блонд,рыжий цвет моих волос и восстановление после завивки в салоне другого города.Косички,причёски,куча мероприятий на которые она меня собирала.🫶.Своих мальчишек тоже стригу только у Светланы.Да и в целом салон очень уютный.Девчонки-администраторы внимательные,всегда предложат чай,кофе.Всегда приятная атмосфера.",
      "rating": 5,
      "date": "2025-11-19",
      "photos": [],
      "business_reply": null
    },
    {
      "review_id": "HlQhWpAe-xDAF6zAaGkxzaaqooBHeIN",
      "author": "Арефьева Виктория",
      "text": "Хотела бы выразить Благодарнось, Анастасии Жуковой! Прекрасный стилист по волосам! Учла все мои пожелания! Выполнила великолепно свою работу! А еще Анастасия посоветовала мне уход для волос, и с ним мои волосы преобразились!  Отзывчивая, добрая и приятная девушка, хороший собеседник и грамотный специалист ! Спасибо 🫶🏻",
      "rating": 5,
      "date": "2025-11-18",
      "photos": [
        "https://avatars.mds.yandex.net/get-altay/16299341/2a0000019a9628d76afca78da2e1d7803dc8/orig"
      ],
