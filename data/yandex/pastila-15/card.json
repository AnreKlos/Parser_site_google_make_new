  "reviews_preview": [
    {
      "review_id": "n0W6TZMDaInY8lc808nqEz2I3orQCM0wi",
      "author": "Беженарь Вероника",
      "text": "Абсолютно шикарный опыт в студии красоты «Пастила»\nМастера — настоящие художники, которые великолепно воплощают желания в жизнь. Атмосфера очень уютная, чувствуешь себя комфортно и расслаблено.\n\nОсобенно впечатлила стерильность и чистота восхищают и создают полное доверие. Без раздумий ставлю пять звёзд!\n\nСпасибо «Пастила» за великолепный маникюр и уверенность, которую вы дарите! 💅✨",
      "rating": 5,
      "date": "2025-11-11",
      "photos": [],
      "business_reply": null
    },
    {
      "review_id": "LqDO9zHI9h392-qImNPqi2FpE3OSLb",
      "author": "Ольга босенко",
      "text": "Все о маникюре и педикюре\nА я о мастере шугаринга\nСделала депиляцию у мастерв Евгении и очень довольна. Процедура выполнена быстро и почти безболезненно. Результат превосходный! Гладкость кожи идеальная, не осталось ни одного лишнего волоска. За непринужденной беседой не заметила, как пролетело время. Очень приятный человек и отличный специалист. Всем советую посетить этого замечательного мастера. Я уже записалась в ряды ее постоянных клиентов.",
      "rating": 5,
      "date": "2025-11-12",
      "photos": [],
      "business_reply": null
    },
    {
      "review_id": "N5tWFnZBvtIn2bY4DH639SlbSwCppyVR",
      "author": "наталья е.",
      "text": "Посещаю студию много лет и всегда остаюсь довольна. Хочу отдельно отметить мастера шугаринга Евгению, у которой просто золотые руки. Она выполняет работу безукоризненно, очень аккуратна и внимательна. Кроме того, в студии всегда идеальная чистота и приятная обстановка. Чувствуется забота о каждом клиенте. Все девочки мастера своего дела. Спасибо за ваш труд!",
      "rating": 5,
      "date": "2025-12-03",
      "photos": [],
      "business_reply": null
    }
  ],
